   "source": [
    "Fibbonacci Number"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "4bb978ca",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "55\n"
     ]
    }
   ],
   "source": [
    "n = int(input())\n",
    "def fib(n):\n",
    "    if n == 0 or n == 1:\n",
    "        return n\n",
    "    return fib(n-1) + fib(n-2)\n",
    "print(fib(n))"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "01f4d33c",
   "metadata": {},
   "source": [
    "Fibbonacci Number: Using for loop"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "5a940d31",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "55\n"
     ]
    }
   ],
   "source": [
    "n = int(input())\n",
    "a = 0\n",
    "b = 1\n",
    "for i in range(n):\n",
    "    a,b = b, b+a\n",
    "print(a)"
   ]
